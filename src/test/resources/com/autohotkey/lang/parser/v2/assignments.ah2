;Following are valid assignments
MyNumber := 123
MyString := "This is a literal string."
CopyOfVar := Var
  Indented := 1
NoSpaces:=1
Tabs	:=	1
Chained := Other := 1
WithComment := 1 ; comment
Empty :=
a_1 := b_2

;Following are not simple assignments
:= 5
a.b := 1
a[1] := 1
a, b := 1
a: = 1
a = 1
MsgBox "a := 1"
