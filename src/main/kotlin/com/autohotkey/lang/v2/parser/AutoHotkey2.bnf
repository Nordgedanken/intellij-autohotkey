{
  parserClass="com.autohotkey.lang.v2.parser.Ahk2Parser"

  extends='com.intellij.extapi.psi.ASTWrapperPsiElement'

  psiClassPrefix="Ahk2"
  psiImplClassSuffix="Impl"
  psiPackage="com.autohotkey.lang.v2.psi"
  psiImplPackage="com.autohotkey.lang.v2.psi.impl"

  elementTypeHolderClass="com.autohotkey.lang.v2.psi.Ahk2Types"
  elementTypeClass="com.autohotkey.lang.v2.psi.Ahk2ElementType"
  tokenTypeClass="com.autohotkey.lang.psi.AhkTokenType"

  tokens = [
    //Ahk-specific
    CHAR_SPECIAL="regexp:\p{Punct}"
    COMMA       = ','
    HASH        = '#'
    COLONCOLON  = '::'
    COLON       = ':'
    COLONEQUAL  = ':='
    BACKTICK    = '`'

    //generic
    WS_HOZ="regexp:\p{Blank}+"
    CRLF="regexp:\v"
    // A line comment must be at the beginning of a line or preceded by whitespace, which the lexer handles
    LINE_COMMENT
    IDENTIFIER='regexp:\w+'
  ]
}

/*
  Whitespace is not skipped by the parser, so rules must say where it is allowed.
  Alternatives are tried in order, so more specific statements must come first.
*/

Ahk2File ::= Item*
private Item ::= Statement | LINE_COMMENT | CRLF
private Statement ::= Hotstring_stmt | Hotkey_stmt | Assignment_stmt | Directive_stmt | Word+

// Following may only start a line, after optional whitespace.
// Hotkeys must be checked before directives since hotkeys can begin with a # (eg "#a::")
Hotstring_stmt ::= WS_HOZ? Hotstring Word*
Hotstring ::= (':' Hotstring_char* ':' | '::') Hotstring_char+ '::'
private Hotstring_char ::= '#' | ',' | '`' | CHAR_SPECIAL | IDENTIFIER | WS_HOZ

// Any run of chars (optionally separated by whitespace, eg "LControl & RAlt") followed by ::
// We don't check that it is a valid key. An annotator can do that.
Hotkey_stmt ::= WS_HOZ? Hotkey Word*
Hotkey ::= Hotkey_char (WS_HOZ? Hotkey_char)* '::'
private Hotkey_char ::= '#' | ',' | '`' | CHAR_SPECIAL | IDENTIFIER

// v2 requires whitespace between the name and its params (no "#Name, param"). We don't check that the name is real.
Directive_stmt ::= WS_HOZ? Directive (WS_HOZ Word*)? End_of_stmt
Directive ::= '#' IDENTIFIER

// Variable assignment. The expression is just a run of words for now and will be parsed in more detail later.
// Hotkeys/hotstrings can't contain a single : so there's no ambiguity with them
Assignment_stmt ::= WS_HOZ? Variable WS_HOZ? ':=' Expression?
Variable ::= IDENTIFIER
Expression ::= Word+

private Word ::= ':=' | ':' | '::' | Hotkey_char | WS_HOZ
private End_of_stmt ::= &(CRLF | LINE_COMMENT) | <<eof>>
